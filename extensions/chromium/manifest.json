{
  "manifest_version": 3,
  "name": "wroopmark",
  "version": "0.1.0",
  "description": "X, TikTok, Reddit, YouTube, Instagram, GitHub, Hacker News ve web sayfalarını çevrimdışı wroopmark arşivine kaydeder.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.tiktok.com/*",
    "https://*.reddit.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://github.com/*",
    "https://news.ycombinator.com/*",
    "https://lobste.rs/*",
    "https://arxiv.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "wroopmark",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
